# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=state_forms

# Discord OAuth2
# Получить на https://discord.com/developers/applications
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# Session Secret
# Сгенерировать случайную строку: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_session_secret_here

# Encryption Key (32 bytes in hex format)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (optional)
FRONTEND_URL=http://localhost:3001
# STAGING_URL=https://staging.your-domain.com

# Optional: Set to 'staging' for staging environment
# NODE_ENV=staging
# ALLOW_INSECURE_COOKIE=true
