# Staging environment — copy to .env.staging and fill in.
# NEVER commit .env.staging (it is gitignored).

# --- Server ---
PORT=3002
SESSION_SECRET=change-me-generate-a-random-64-hex-string

# --- Database ---
# Local MySQL. Create the database first (see STAGING.md).
DB_HOST=localhost
DB_USER=state_forms_user
DB_PASSWORD=change-me
DB_NAME=state_forms_staging
DB_PORT=3306

# 64 hex chars (32 bytes) — used for AES-256-CBC webhook encryption.
ENCRYPTION_KEY=change-me-64-hex-chars

# --- Discord OAuth ---
# Staging requires its OWN Discord app (or its own redirect URI registered
# on the existing app). Discord matches redirect_uri exactly.
# For local dev over HTTP, set this to http://localhost:3002/auth/discord/callback
# and run with ALLOW_INSECURE_COOKIE=1 (see below).
DISCORD_CLIENT_ID=change-me
DISCORD_CLIENT_SECRET=change-me
DISCORD_REDIRECT_URI=http://localhost:3002/auth/discord/callback

# --- Local dev only ---
# Set to 1 to disable the secure-cookie flag so the session survives over
# plain HTTP on localhost. Do NOT use in any environment reachable from the internet.
ALLOW_INSECURE_COOKIE=1
